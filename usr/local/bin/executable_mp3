#!/bin/bash

usage() {
    echo "Usage: mp3 [-o name] URL [quality]"
    echo "Quality levels: high, mid, low (default: mid)"
    echo "Options:"
    echo "  -o name    Output filename (without extension)"
    exit 1
}

if [[ $# -lt 1 ]]; then
    usage
fi

output=""
while getopts ":o:" opt; do
    case $opt in
        o) output="$OPTARG" ;;
        \?) echo "Invalid option: -$OPTARG"; usage ;;
        :) echo "Option -$OPTARG requires an argument"; usage ;;
    esac
done
shift $((OPTIND - 1))

if [[ $# -lt 1 ]]; then
    usage
fi

args=("$@")
quality="${args[-1]}"
url=""

if [[ "$quality" =~ ^(high|mid|low)$ ]]; then
    url="${args[*]:0:$#-1}"
else
    url="$*"
    quality="mid"
fi

case "$quality" in
    high) bitrate="320k" ;;
    mid)  bitrate="192k" ;;
    low)  bitrate="128k" ;;
esac

if [[ -n "$output" ]]; then
    outfile="${output}.mp3"
    template="$output.%(ext)s"
else
    outfile=""
    template="audio_%(title)s.%(ext)s"
fi

echo "Downloading audio from $url at $quality quality..."

yt-dlp -f bestaudio --extract-audio --audio-format mp3 --audio-quality 0 \
    -o "$template" "$url"

if [[ -n "$outfile" ]]; then
    # Single file mode
    if [[ -f "$outfile" ]]; then
        echo "Re-encoding $outfile..."
        ffmpeg -y -i "$outfile" -b:a "$bitrate" "${outfile%.mp3}_tmp.mp3"
        if [[ -f "${outfile%.mp3}_tmp.mp3" ]]; then
            rm "$outfile"
            mv "${outfile%.mp3}_tmp.mp3" "$outfile"
        fi
    fi
else
    # Glob mode
    for f in audio_*.mp3; do
        [[ -f "$f" ]] || continue
        echo "Re-encoding $f..."
        ffmpeg -y -i "$f" -b:a "$bitrate" "${f%.mp3}_tmp.mp3"
        if [[ -f "${f%.mp3}_tmp.mp3" ]]; then
            rm "$f"
            mv "${f%.mp3}_tmp.mp3" "$f"
        fi
    done
fi

echo "Done!"