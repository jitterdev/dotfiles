{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "foxy.png",
        "width": 12,
        "height": 6,
        "padding": {
            "top": 2,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 15
        }
    },
    "modules": [
        "title",
        {
            "type": "colors",
            "block": {
                "width": 2
            }
        },
        "break",
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "#f38ba8", // Red
            "format": "{1} {2}"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "#fab387" // Peach
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "#f9e2af" // Yellow
        },
        {
            "type": "disk",
            "key": "{1}",
            "keyColor": "#a6e3a1" // Green
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "#74c7ec" // Sapphire
        },
        {
            "type": "swap",
            "key": "Swap",
            "keyColor": "#cba6f7" // Mauve
        }
    ]
}