{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 15
        }
    },
    "modules": [
        "title",
        {
            "type": "colors",
            "symbol": "block",
            "block": {
                "width": 2,
                "range": [0, 15]
            }
        },
        "break",
        
        {
            "type": "os",
            "key": "OS",
            "keyColor": "#f38ba8" // Red
        },
        {
            "type": "host",
            "key": "Host",
            "keyColor": "#fab387" // Peach
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "keyColor": "#f9e2af", // Yellow
            "format": "{1} {2}"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "#a6e3a1" // Green
        },
        {
            "type": "packages",
            "key": "Packages",
            "keyColor": "#94e2d5" // Teal
        },
        {
            "type": "shell",
            "key": "Shell",
            "keyColor": "#89dceb" // Sky
        },
        {
            "type": "display",
            "key": "Display",
            "keyColor": "#74c7ec", // Sapphire
            "format": "{1}x{2} @ {3}Hz - {4}"
        },

        {
            "type": "de",
            "key": "DE",
            "keyColor": "#89b4fa" // Blue
        },
        {
            "type": "wm",
            "key": "WM",
            "keyColor": "#b4befe" // Lavender
        },
        {
            "type": "wmtheme",
            "key": "WM Theme",
            "keyColor": "#cba6f7" // Mauve
        },
        {
            "type": "theme",
            "key": "Theme",
            "keyColor": "#f38ba8" // Red (Loop)
        },
        {
            "type": "icons",
            "key": "Icons",
            "keyColor": "#fab387" // Peach
        },
        {
            "type": "font",
            "key": "Font",
            "keyColor": "#f9e2af" // Yellow
        },
        {
            "type": "cursor",
            "key": "Cursor",
            "keyColor": "#a6e3a1" // Green
        },
        {
            "type": "terminal",
            "key": "Terminal",
            "keyColor": "#94e2d5" // Teal
        },

        {
            "type": "cpu",
            "key": "CPU",
            "keyColor": "#89dceb" // Sky
        },
        {
            "type": "gpu",
            "keyColor": "#74c7ec" // Sapphire
        },
        {
            "type": "memory",
            "key": "Memory",
            "keyColor": "#89b4fa" // Blue
        },
        {
            "type": "swap",
            "key": "Swap",
            "keyColor": "#b4befe" // Lavender
        },
        {
            "type": "disk",
            "key": "{1}",
            "keyColor": "#cba6f7" // Mauve
        },
        {
            "type": "battery",
            "key": "Battery",
            "keyColor": "#f38ba8" // Red
        },
        {
            "type": "poweradapter",
            "key": "Power",
            "keyColor": "#fab387" // Peach
        },
        
        {
            "type": "locale",
            "key": "Locale",
            "keyColor": "#f9e2af" // Yellow
        },
        {
            "type": "localip",
            "key": "{2}",
            "keyColor": "#a6e3a1" // Green
        }
    ]
}